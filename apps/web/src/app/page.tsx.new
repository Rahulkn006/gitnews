"use client";

import { useQuery } from "convex/react";
import { api } from "@v1/backend/convex/_generated/api";
import Link from "next/link";
import { RepoCard } from "@/components/repo-card";
import { AiNewsBrief } from "@/components/ai-news-brief";
import { LanguageChart } from "@/components/language-chart";
import { NewsletterCard } from "@/components/newsletter-card";
import { mockRepositories } from "@/data/repositories";
import { mockNewsArticles } from "@/data/news";

export default function Page() {
  const dbRepos = useQuery(api.github.getTrendingRepos);
  const repositories = dbRepos && dbRepos.length > 0 ? dbRepos : mockRepositories;

  const dbNews = useQuery(api.news.getNews);
  const news = dbNews && dbNews.length > 0 ? dbNews : mockNewsArticles;

  const sortedRepos = [...repositories].sort((a: any, b: any) => (b.stars ?? 0) - (a.stars ?? 0));

  const featuredRepo = sortedRepos[0];
  const mediumRepos = sortedRepos.slice(1, 3);
  const smallRepos = sortedRepos.slice(3, 6);
  const yesterdayHighlights = sortedRepos.slice(6, 10);

  const languages = Array.from(
    repositories.reduce((acc: Map<string, number>, repo: any) => {
      if (repo.language) {
        acc.set(repo.language, (acc.get(repo.language) ?? 0) + 1);
      }
      return acc;
    }, new Map<string, number>())
    .entries()
  )
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5);

  const formatDate = () => {
    const d = new Date();
    return d.toLocaleDateString("en-US", {
      weekday: "long",
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  };

  const tickerItems = sortedRepos.slice(0, 8).map((repo: any) => {
    const starText = repo.stars >= 1000 ? `${(repo.stars / 1000).toFixed(1)}k` : String(repo.stars);
    return `${repo.owner}/${repo.name} · ${starText} ★`;
  });

  return (
    <div className="w-full min-h-screen bg-background text-foreground font-mono px-4 md:px-8 py-8 selection:bg-primary selection:text-primary-foreground">
      {/* Live ticker */}
      <div className="max-w-7xl mx-auto mb-6 overflow-hidden border border-border bg-card/40">
        <div className="flex items-center">
          <div className="shrink-0 border-r border-border bg-primary/10 px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-primary">
            ▸ Live Wire
          </div>
          <div className="relative flex w-full overflow-x-hidden">
            <div className="flex animate-marquee items-center whitespace-nowrap">
              {[...tickerItems, ...tickerItems].map((item, i) => (
                <span key={i} className="mx-6 text-[10px] font-mono text-muted-foreground">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>

      {/* Magazine Banner */}
      <header className="max-w-7xl mx-auto border-b border-rule pb-6 mb-10">
        <div className="flex flex-col md:flex-row items-center justify-between gap-4 py-4">
          <div>
            <span className="text-[10px] tracking-[0.35em] text-primary font-bold uppercase block mb-1">
              // GITHUB NEWS CHRONICLE //
            </span>
            <h1 className="font-serif text-4xl md:text-5xl font-extrabold tracking-tight italic text-foreground">
              GITNEWS
            </h1>
          </div>
          <div className="flex items-center gap-4 text-[10px] font-mono text-muted-foreground">
            <span>ISSUE 186</span>
            <span>•</span>
            <span className="font-bold text-foreground">{formatDate()}</span>
            <span>•</span>
            <span className="text-primary bg-primary/10 px-2 py-0.5 border border-primary/20">
              LIVE BACKEND
            </span>
          </div>
        </div>
      </header>

      {/* Main Magazine Columns Layout */}
      <main className="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8">
        {/* Left Column: Repository Bento Discovery flow */}
        <div className="lg:col-span-9 flex flex-col gap-10">
          {/* Todays Picks Bento Layout */}
          <section>
            <h2 className="text-xs font-bold text-muted-foreground uppercase tracking-widest mb-6 flex items-center gap-2 border-b border-rule pb-2">
              <span className="w-1.5 h-1.5 bg-primary rounded-full" />
              Todays Picks // Bento Audit
            </h2>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[minmax(180px,_auto)]">
              {featuredRepo && (
                <div className="md:col-span-2 md:row-span-2">
                  <RepoCard repo={featuredRepo} size="large" />
                </div>
              )}

              {mediumRepos.map((repo: any) => (
                <div key={repo._id || repo.id} className="md:col-span-1">
                  <RepoCard repo={repo} size="medium" />
                </div>
              ))}

              <div className="md:col-span-1 flex flex-col gap-4 justify-between">
                <span className="text-[9px] font-mono text-muted-foreground uppercase tracking-wider block border-b border-rule/60 pb-1">
                  ⚡ Quick Discoveries
                </span>
                {smallRepos.map((repo: any) => (
                  <RepoCard key={repo._id || repo.id} repo={repo} size="small" />
                ))}
              </div>
            </div>
          </section>

          {/* Yesterdays Highlights Section */}
          {yesterdayHighlights.length > 0 && (
            <section>
              <h2 className="text-xs font-bold text-muted-foreground uppercase tracking-widest mb-6 flex items-center gap-2 border-b border-rule pb-2">
                <span className="w-1.5 h-1.5 bg-primary/40 rounded-full" />
                Yesterdays Highlights
              </h2>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                {yesterdayHighlights.map((repo: any) => (
                  <RepoCard key={repo._id || repo.id} repo={repo} size="medium" />
                ))}
              </div>
            </section>
          )}
        </div>

        {/* Right Thin Sidebar */}
        <aside className="lg:col-span-3 border-t lg:border-t-0 lg:border-l border-rule lg:pl-6 flex flex-col gap-8">
          <AiNewsBrief items={news} />
          <LanguageChart languages={languages} />
          <NewsletterCard />

          <div className="pt-4 border-t border-rule">
            <Link
              href="/news"
              className="text-xs font-mono text-primary hover:underline flex items-center gap-1"
            >
              → Read AI News Magazine
            </Link>
          </div>
        </aside>
      </main>
    </div>
  );
}
