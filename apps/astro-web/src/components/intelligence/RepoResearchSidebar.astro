---
import GitNewsIcon from "@/components/ui/GitNewsIcon.astro";

interface Props {
  repoName: string;
  analysis: any; // Ollagraph analysis object
  score: number;
}

const { repoName, analysis, score } = Astro.props;

// Compute values safely with fallbacks
const whatItDoes = analysis.whatItDoes || "A popular open-source repository.";
const mainPurpose =
  analysis.summary || "Provides tools and utilities for developers.";
const whoShouldUse =
  analysis.bestUseCases || "Developers looking to optimize their workflow.";
const devLevel = analysis.learningDifficulty || "Intermediate";
const learningValue = analysis.learningValue || "High";
const productionReady =
  analysis.developerAdoption || "Widely adopted by the community.";
const futurePotential = analysis.futurePotential || "Strong growth expected.";

// Score cards
const learningScore = analysis.scores?.learningValue
  ? `${analysis.scores.learningValue}/100`
  : "95/100";
const marketDemand = analysis.scores?.marketDemand
  ? `${analysis.scores.marketDemand}/100`
  : "High";
const communityStrength = analysis.scores?.community
  ? `${analysis.scores.community}/100`
  : "Excellent";
const futureScope = analysis.scores?.futureScope
  ? `${analysis.scores.futureScope}/100`
  : "Extremely High";
---

<div class="flex flex-col gap-6">
  
  <div class="flex items-center gap-2 mb-2">
    <GitNewsIcon name="ai" class="w-5 h-5 text-emerald-500" weight="fill" />
    <h2 class="text-sm font-black uppercase tracking-widest text-slate-900 dark:text-white">
      AI Repository Summary
    </h2>
  </div>

  {/* Summary List */}
  <div class="bg-stone-50 dark:bg-[#111] rounded-xl p-5 border border-stone-200 dark:border-stone-800 flex flex-col gap-4">
    <div class="flex flex-col gap-1 pb-3 border-b border-stone-200 dark:border-stone-800/50">
      <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">What this does</span>
      <span class="text-sm font-medium text-stone-900 dark:text-white leading-snug">{whatItDoes}</span>
    </div>
    
    <div class="flex flex-col gap-1 pb-3 border-b border-stone-200 dark:border-stone-800/50">
      <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Main Purpose</span>
      <span class="text-sm font-medium text-stone-900 dark:text-white leading-snug">{mainPurpose}</span>
    </div>

    <div class="flex flex-col gap-1 pb-3 border-b border-stone-200 dark:border-stone-800/50">
      <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Who should use it</span>
      <span class="text-sm font-medium text-stone-900 dark:text-white leading-snug">{whoShouldUse}</span>
    </div>

    <div class="flex flex-col gap-1 pb-3 border-b border-stone-200 dark:border-stone-800/50">
      <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Developer Level</span>
      <span class="text-sm font-bold text-blue-500">{devLevel}</span>
    </div>

    <div class="flex flex-col gap-1 pb-3 border-b border-stone-200 dark:border-stone-800/50">
      <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Learning Value</span>
      <span class="text-sm font-bold text-amber-500">{learningValue}</span>
    </div>

    <div class="flex flex-col gap-1 pb-3 border-b border-stone-200 dark:border-stone-800/50">
      <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Production Readiness</span>
      <span class="text-sm font-medium text-emerald-500">{productionReady}</span>
    </div>

    <div class="flex flex-col gap-1">
      <span class="text-[10px] font-black uppercase tracking-widest text-slate-500">Future Potential</span>
      <span class="text-sm font-medium text-purple-500">{futurePotential}</span>
    </div>
  </div>

  {/* Score Cards Grid */}
  <div class="grid grid-cols-2 gap-3">
    
    <div class="bg-stone-50 dark:bg-stone-900/50 rounded-xl p-4 border border-stone-200 dark:border-stone-800 flex flex-col justify-between h-24 hover:border-amber-500/30 transition-colors">
      <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Learning Score</h3>
      <span class="text-xl font-black text-amber-500">{learningScore}</span>
    </div>

    <div class="bg-stone-50 dark:bg-stone-900/50 rounded-xl p-4 border border-stone-200 dark:border-stone-800 flex flex-col justify-between h-24 hover:border-emerald-500/30 transition-colors">
      <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Market Demand</h3>
      <span class="text-lg font-black text-emerald-500 leading-tight">{marketDemand}</span>
    </div>

    <div class="bg-stone-50 dark:bg-stone-900/50 rounded-xl p-4 border border-stone-200 dark:border-stone-800 flex flex-col justify-between h-24 hover:border-blue-500/30 transition-colors">
      <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Community Strength</h3>
      <span class="text-lg font-black text-blue-500 leading-tight">{communityStrength}</span>
    </div>

    <div class="bg-stone-50 dark:bg-stone-900/50 rounded-xl p-4 border border-stone-200 dark:border-stone-800 flex flex-col justify-between h-24 hover:border-purple-500/30 transition-colors">
      <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-500">Future Scope</h3>
      <span class="text-sm font-bold text-purple-500 leading-tight">{futureScope}</span>
    </div>

  </div>

</div>
