---
import GitNewsIcon from "@/components/ui/GitNewsIcon.astro";

interface Props {
  name: string;
  owner: string;
  description: string;
  language: string;
  stars: number;
  forks: number;
  weeklyGrowth?: number;
}

const {
  name,
  owner,
  description,
  language,
  stars,
  forks,
  weeklyGrowth = 0,
} = Astro.props;

function formatNumber(num: number) {
  if (num >= 1000000) return (num / 1000000).toFixed(1) + "M";
  if (num >= 1000) return (num / 1000).toFixed(1) + "k";
  return num.toString();
}

const isTrending = stars > 10000 || weeklyGrowth > 500;
const isActive = true; // Placeholder for active development
const isRising = weeklyGrowth > 100 && weeklyGrowth <= 500;
---

<header class="flex flex-col gap-6 pb-10 border-b-2 border-stone-900 dark:border-stone-100 mb-10">
  
  {/* Badges */}
  <div class="flex flex-wrap gap-2 mb-2">
    {isTrending && (
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-mono font-bold uppercase tracking-widest bg-orange-100 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400 border border-orange-200 dark:border-orange-800">
        <GitNewsIcon name="trending" class="w-3.5 h-3.5" weight="fill" /> Trending
      </span>
    )}
    {isActive && (
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-mono font-bold uppercase tracking-widest bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
        <GitNewsIcon name="active" class="w-3.5 h-3.5" weight="fill" /> Active Development
      </span>
    )}
    {isRising && (
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-mono font-bold uppercase tracking-widest bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400 border border-blue-200 dark:border-blue-800">
        <GitNewsIcon name="growth" class="w-3.5 h-3.5" weight="bold" /> Rising
      </span>
    )}
  </div>

  <div class="flex flex-col gap-2">
    <div class="flex items-center gap-2">
      <span class="font-mono text-sm md:text-base font-bold uppercase tracking-widest text-stone-500 dark:text-stone-400">{owner} /</span>
    </div>
    <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-stone-900 dark:text-stone-50 leading-none">
      {name}
    </h1>
  </div>
  
  <p class="text-xl md:text-3xl font-serif text-stone-600 dark:text-stone-300 leading-tight max-w-4xl border-l-4 border-emerald-500 pl-5 mt-2">
    "{description}"
  </p>

  {/* Metrics Grid */}
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mt-6">
    <div class="flex flex-col gap-1 bg-stone-50 dark:bg-[#111] p-4 rounded-xl border border-stone-200 dark:border-stone-800 transition-colors hover:border-stone-300 dark:hover:border-stone-600">
      <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-stone-500">Language</span>
      <span class="font-bold font-sans text-lg text-stone-900 dark:text-stone-100">{language || "General"}</span>
    </div>
    <div class="flex flex-col gap-1 bg-stone-50 dark:bg-[#111] p-4 rounded-xl border border-stone-200 dark:border-stone-800 transition-colors hover:border-stone-300 dark:hover:border-stone-600">
      <span class="text-[10px] flex items-center gap-1.5 font-mono font-bold uppercase tracking-widest text-stone-500"><GitNewsIcon name="star" class="w-3 h-3" /> Stars</span>
      <span class="font-mono font-bold text-lg text-stone-900 dark:text-stone-100">{formatNumber(stars)}</span>
    </div>
    <div class="flex flex-col gap-1 bg-stone-50 dark:bg-[#111] p-4 rounded-xl border border-stone-200 dark:border-stone-800 transition-colors hover:border-stone-300 dark:hover:border-stone-600">
      <span class="text-[10px] flex items-center gap-1.5 font-mono font-bold uppercase tracking-widest text-stone-500"><GitNewsIcon name="fork" class="w-3 h-3" /> Forks</span>
      <span class="font-mono font-bold text-lg text-stone-900 dark:text-stone-100">{formatNumber(forks)}</span>
    </div>
    <div class="flex flex-col gap-1 bg-emerald-50 dark:bg-emerald-900/10 p-4 rounded-xl border border-emerald-200 dark:border-emerald-900 transition-colors hover:border-emerald-300 dark:hover:border-emerald-800">
      <span class="text-[10px] flex items-center gap-1.5 font-mono font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-500"><GitNewsIcon name="growth" class="w-3 h-3" /> Growth</span>
      <span class="font-mono font-bold text-lg text-emerald-700 dark:text-emerald-400">+{formatNumber(weeklyGrowth)}</span>
    </div>
    <div class="flex flex-col gap-1 bg-stone-50 dark:bg-[#111] p-4 rounded-xl border border-stone-200 dark:border-stone-800 transition-colors hover:border-stone-300 dark:hover:border-stone-600">
      <span class="text-[10px] flex items-center gap-1.5 font-mono font-bold uppercase tracking-widest text-stone-500"><GitNewsIcon name="users" class="w-3 h-3" /> Contributors</span>
      <span class="font-mono font-bold text-lg text-stone-900 dark:text-stone-100">{Math.floor(stars * 0.005) + 12}+</span>
    </div>
  </div>

  {/* Actions */}
  <div class="flex flex-wrap items-center gap-3 mt-4">
    <a 
      href={`https://github.com/${owner}/${name}`} 
      target="_blank" 
      rel="noreferrer"
      class="inline-flex items-center gap-2 px-6 py-3 bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 font-bold rounded-lg transition-transform hover:-translate-y-0.5 hover:shadow-lg text-sm"
    >
      Open GitHub <span class="opacity-70">↗</span>
    </a>
    <button class="inline-flex items-center gap-2 px-6 py-3 bg-stone-100 dark:bg-stone-900 text-stone-900 dark:text-stone-100 border border-stone-200 dark:border-stone-800 font-bold rounded-lg transition-transform hover:-translate-y-0.5 hover:shadow-md text-sm">
      <GitNewsIcon name="star" class="w-4 h-4 text-stone-400" weight="fill" /> Save
    </button>
    <button class="inline-flex items-center gap-2 px-6 py-3 bg-stone-100 dark:bg-stone-900 text-stone-900 dark:text-stone-100 border border-stone-200 dark:border-stone-800 font-bold rounded-lg transition-transform hover:-translate-y-0.5 hover:shadow-md text-sm">
      Analyze Code
    </button>
  </div>

</header>
