---
// Section 4: Ollagraph Ready Area
interface Props {
  readmeAnalysis?: string;
  docsInsights?: string;
  blogResearch?: string;
  communityDiscussions?: string;
}

const {
  readmeAnalysis = "The README is highly structured, providing immediate quick-starts, architecture diagrams, and contribution guidelines. Indicates strong maintainer discipline.",
  docsInsights = "Comprehensive documentation site available, covering edge cases and advanced API usage. High quality standard.",
  blogResearch = "Recently featured in top-tier engineering blogs highlighting its performance benefits in high-concurrency environments.",
  communityDiscussions = "Highly active on HackerNews and Reddit with positive sentiment regarding its minimal API footprint and DX."
} = Astro.props;
---

<section class="flex flex-col gap-6 mb-12">
  <div class="flex items-center gap-3 mb-2 border-b-2 border-stone-900 dark:border-stone-100 pb-3">
    <span class="w-3 h-3 bg-purple-500 rounded-sm rotate-45 animate-pulse"></span>
    <h2 class="text-2xl font-serif font-black uppercase tracking-tight text-stone-900 dark:text-white">
      Ollagraph Deep Research
    </h2>
    <span class="px-2 py-0.5 bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400 text-[9px] font-mono font-bold uppercase tracking-widest rounded-md border border-purple-200 dark:border-purple-800 ml-2">
      Beta
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-stone-50/80 dark:bg-[#111]/80 border border-stone-200 dark:border-stone-800 p-5 rounded-xl flex flex-col gap-2 group hover:border-purple-500/30 transition-colors relative overflow-hidden">
      <div class="absolute top-0 right-0 w-16 h-16 bg-gradient-to-bl from-purple-500/10 to-transparent rounded-bl-full pointer-events-none"></div>
      <h3 class="font-mono text-[10px] font-bold uppercase tracking-widest text-purple-600 dark:text-purple-400">README Analysis</h3>
      <p class="font-sans text-stone-700 dark:text-stone-300 text-sm leading-relaxed mt-1 relative z-10">
        {readmeAnalysis}
      </p>
    </div>

    <div class="bg-stone-50/80 dark:bg-[#111]/80 border border-stone-200 dark:border-stone-800 p-5 rounded-xl flex flex-col gap-2 group hover:border-purple-500/30 transition-colors relative overflow-hidden">
      <div class="absolute top-0 right-0 w-16 h-16 bg-gradient-to-bl from-purple-500/10 to-transparent rounded-bl-full pointer-events-none"></div>
      <h3 class="font-mono text-[10px] font-bold uppercase tracking-widest text-purple-600 dark:text-purple-400">Documentation Insights</h3>
      <p class="font-sans text-stone-700 dark:text-stone-300 text-sm leading-relaxed mt-1 relative z-10">
        {docsInsights}
      </p>
    </div>

    <div class="bg-stone-50/80 dark:bg-[#111]/80 border border-stone-200 dark:border-stone-800 p-5 rounded-xl flex flex-col gap-2 group hover:border-purple-500/30 transition-colors relative overflow-hidden">
      <div class="absolute top-0 right-0 w-16 h-16 bg-gradient-to-bl from-purple-500/10 to-transparent rounded-bl-full pointer-events-none"></div>
      <h3 class="font-mono text-[10px] font-bold uppercase tracking-widest text-purple-600 dark:text-purple-400">Blog & Media Research</h3>
      <p class="font-sans text-stone-700 dark:text-stone-300 text-sm leading-relaxed mt-1 relative z-10">
        {blogResearch}
      </p>
    </div>

    <div class="bg-stone-50/80 dark:bg-[#111]/80 border border-stone-200 dark:border-stone-800 p-5 rounded-xl flex flex-col gap-2 group hover:border-purple-500/30 transition-colors relative overflow-hidden">
      <div class="absolute top-0 right-0 w-16 h-16 bg-gradient-to-bl from-purple-500/10 to-transparent rounded-bl-full pointer-events-none"></div>
      <h3 class="font-mono text-[10px] font-bold uppercase tracking-widest text-purple-600 dark:text-purple-400">Community Sentiment</h3>
      <p class="font-sans text-stone-700 dark:text-stone-300 text-sm leading-relaxed mt-1 relative z-10">
        {communityDiscussions}
      </p>
    </div>
  </div>
</section>
