---
// Section 5: YouTube Learning Hub
import GitNewsIcon from "@/components/ui/GitNewsIcon.astro";
import { youtubeService } from "@/services/youtube";
import YoutubeCard from "./YoutubeCard.astro";

interface Props {
  repoName: string;
  owner: string;
  language?: string;
}

const { repoName, owner, language } = Astro.props;

// Fetch real videos or use mock fallback internally
const allVideos = await youtubeService.getLearningVideos(
  repoName,
  owner,
  language,
);
const videos = allVideos.slice(0, 10);
---

<section class="flex flex-col gap-6 mt-8 mb-12">
  <div class="flex items-center gap-3 mb-2 border-b border-stone-200 dark:border-stone-800 pb-4">
    <GitNewsIcon name="play" class="w-6 h-6 text-red-500" weight="fill" />
    <h2 class="text-2xl font-serif font-black uppercase tracking-tight text-stone-900 dark:text-white">
      YouTube Learning Hub
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    {videos.map((video: any) => (
      <YoutubeCard {...video} />
    ))}
  </div>
</section>
