---
// Footer.astro — global site footer for the Astro layout
const currentYear = new Date().getFullYear();

const footerLinks = {
  discover: [
    { name: "Trending", href: "/trending" },
    { name: "AI Projects", href: "/ai-projects" },
    { name: "Repositories", href: "/repositories" },
    { name: "News", href: "/news" },
    { name: "Market", href: "/market" },
  ],
  intelligence: [
    { name: "Analyze", href: "/analyze" },
    { name: "Repo Battle", href: "/olla/compare" },

    { name: "Company Index", href: "/olla/company-index" },
  ],
  learn: [
    { name: "Interview Prep", href: "/learning/interview" },
    { name: "Project Ideas", href: "/learning/projects" },
    { name: "Similar Repos", href: "/learning/similar" },
  ],
  legal: [
    { name: "GitHub", href: "https://github.com/Rahulkn006/gitnews" },
    { name: "License", href: "/LICENSE.md" },
  ],
};
---

<footer class="w-full border-t border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-[#0a0a0a]">
  <!-- Top decorative rule -->
  <div class="h-1 w-full bg-gradient-to-r from-emerald-500/20 via-emerald-500/60 to-emerald-500/20"></div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <!-- Masthead -->
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 pb-10 border-b border-stone-200 dark:border-stone-800 mb-10">
      <div>
        <a href="/" class="flex items-center gap-2 group">
          <span class="font-serif font-black text-3xl text-slate-900 dark:text-white tracking-tighter flex items-center gap-2">
            <svg class="w-6 h-6 text-emerald-600 dark:text-emerald-500 group-hover:rotate-12 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 4h-2m2 0h-3m3 0V9m-3 3h3m-3 3h3m-3 3h3M9 17h1m-1-3h1m-1-3h1m-1-3h1" />
            </svg>
            GitNews.
          </span>
        </a>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 max-w-md font-serif leading-relaxed">
          A premium developer technology intelligence magazine. Live GitHub data, AI analysis, and market signals for the open-source economy.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-8">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center justify-center px-2 py-1 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/20 rounded font-bold text-[10px] uppercase tracking-wider">Live</span>
          <span class="text-xs font-mono text-slate-500 dark:text-slate-400">Connected to Convex</span>
        </div>
        <a
          href="https://github.com/Rahulkn006/gitnews"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs font-bold font-sans px-4 py-2 rounded-md bg-stone-100 hover:bg-stone-200 dark:bg-stone-900 dark:hover:bg-stone-800 text-slate-700 dark:text-slate-300 border border-stone-200 dark:border-stone-800 transition-all"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.605-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          View Source
        </a>
      </div>
    </div>

    <!-- Link columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 mb-12">
      <div>
        <h3 class="text-[10px] font-mono font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4">Discover</h3>
        <ul class="space-y-2">
          {footerLinks.discover.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-[10px] font-mono font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4">Intelligence</h3>
        <ul class="space-y-2">
          {footerLinks.intelligence.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-[10px] font-mono font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4">Learn</h3>
        <ul class="space-y-2">
          {footerLinks.learn.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-[10px] font-mono font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400 mb-4">Legal</h3>
        <ul class="space-y-2">
          {footerLinks.legal.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-600 dark:text-slate-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-stone-200 dark:border-stone-800 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">
        © {currentYear} GitNews. Open source under MIT License.
      </p>
      <p class="text-xs text-slate-500 dark:text-slate-400 font-mono">
        Built with Astro, React, Convex, Tailwind & Together AI.
      </p>
    </div>
  </div>
</footer>
