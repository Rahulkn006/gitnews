---
import GitNewsIcon from "@/components/ui/GitNewsIcon.astro";

const trends = [
  { rank: 1, name: "AI Agents", score: 99, growth: "+45%" },
  { rank: 2, name: "Open Source LLMs", score: 94, growth: "+22%" },
  { rank: 3, name: "Coding Assistants", score: 88, growth: "+18%" },
  { rank: 4, name: "AI Infrastructure", score: 82, growth: "+15%" },
  { rank: 5, name: "Robotics", score: 76, growth: "+8%" }
];
---

<div class="bg-stone-50 dark:bg-stone-900/50 rounded-xl p-6 border border-stone-200 dark:border-stone-800">
  <h3 class="text-xs font-black uppercase tracking-widest text-slate-500 mb-4 flex items-center gap-2 border-b border-stone-200 dark:border-stone-800 pb-3">
    <GitNewsIcon name="active" class="w-4 h-4 text-emerald-500" /> Trending AI Radar
  </h3>

  <div class="flex flex-col gap-3">
    {trends.map(trend => (
      <div class="flex items-center justify-between group">
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono font-bold text-slate-400 dark:text-slate-500 w-4">#{trend.rank}</span>
          <span class="font-bold text-stone-900 dark:text-stone-100 group-hover:text-emerald-500 transition-colors">
            {trend.name}
          </span>
        </div>
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">{trend.growth}</span>
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-orange-100 dark:bg-orange-900/30 text-orange-600 dark:text-orange-400 text-xs font-bold font-mono">
            {trend.score}
          </div>
        </div>
      </div>
    ))}
  </div>
</div>
