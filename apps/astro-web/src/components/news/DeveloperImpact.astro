---
import GitNewsIcon from "@/components/ui/GitNewsIcon.astro";

const impacts = [
  { title: "Learn Now", description: "Top resources for migrating to new AI frameworks.", icon: "play", color: "text-blue-500", bg: "bg-blue-100 dark:bg-blue-900/30" },
  { title: "Growing Tools", description: "Rising developer platforms leveraging LLMs.", icon: "growth", color: "text-emerald-500", bg: "bg-emerald-100 dark:bg-emerald-900/30" },
  { title: "New Frameworks", description: "Cutting edge orchestration libraries.", icon: "rocket", color: "text-purple-500", bg: "bg-purple-100 dark:bg-purple-900/30" },
  { title: "Research Watch", description: "Academic papers turning into production tools.", icon: "ai", color: "text-orange-500", bg: "bg-orange-100 dark:bg-orange-900/30" }
] as const;
---

<div class="mt-8">
  <h3 class="text-xs font-black uppercase tracking-widest text-slate-500 mb-4 flex items-center gap-2 border-b border-stone-200 dark:border-stone-800 pb-3">
    <GitNewsIcon name="users" class="w-4 h-4 text-blue-500" /> Why Developers Care
  </h3>

  <div class="grid grid-cols-1 gap-4">
    {impacts.map(impact => (
      <a href="#" class="group flex items-start gap-4 p-4 rounded-xl bg-stone-50 dark:bg-stone-900/30 hover:bg-stone-100 dark:hover:bg-stone-800/50 border border-stone-100 dark:border-stone-800 transition-colors">
        <div class={`flex items-center justify-center w-10 h-10 rounded-lg shrink-0 ${impact.bg} ${impact.color}`}>
          <GitNewsIcon name={impact.icon as any} class="w-5 h-5" />
        </div>
        <div>
          <h4 class="font-bold text-stone-900 dark:text-stone-100 group-hover:text-emerald-500 transition-colors">
            {impact.title}
          </h4>
          <p class="text-sm text-stone-600 dark:text-stone-400 leading-snug mt-1">
            {impact.description}
          </p>
        </div>
      </a>
    ))}
  </div>
</div>
