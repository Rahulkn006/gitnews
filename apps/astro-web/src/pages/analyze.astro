---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Analyze — GitNews" description="Deep AI analysis of open-source repositories, trends, and ecosystem signals.">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <!-- Masthead -->
    <div class="border-b border-stone-200 dark:border-stone-800 pb-8 mb-10">
      <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-500 mb-3 block">AI Intelligence</span>
      <h1 class="font-serif font-black text-4xl md:text-5xl text-slate-900 dark:text-white tracking-tighter mb-4">
        Analyze.
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl font-serif leading-relaxed">
        Deep-dive intelligence on open-source repositories, ecosystems, and developer adoption signals. Compare projects, spot rising tools, and understand why repositories win.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      <a href="/olla/compare" class="group p-6 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
        </div>
        <h3 class="font-serif font-bold text-lg text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Compare Repositories</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">Side-by-side analysis of stars, forks, language, and AI-generated verdicts.</p>
      </a>

      <a href="/olla/company-repos" class="group p-6 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 3h1m-1 3h1m-1 3h1" />
          </svg>
        </div>
        <h3 class="font-serif font-bold text-lg text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Company Repositories</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">Track open-source output from Google, Meta, Microsoft, and more.</p>
      </a>

      <a href="/market/signals" class="group p-6 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all">
        <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <h3 class="font-serif font-bold text-lg text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Market Signals</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">Velocity, growth, and ecosystem momentum indicators.</p>
      </a>
    </div>

    <!-- Placeholder analysis section -->
    <div class="border border-stone-200 dark:border-stone-800 rounded-xl p-8 md:p-12 bg-stone-50 dark:bg-[#0f0f0f] text-center">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center mb-6">
        <svg class="w-8 h-8 text-emerald-600 dark:text-emerald-500 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
      </div>
      <h2 class="font-serif font-bold text-2xl text-slate-900 dark:text-white mb-3">Deep analysis is coming soon.</h2>
      <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto mb-6">
        We're wiring together AI-powered repository intelligence, comparison engines, and market signal detection. For now, explore the links above.
      </p>
      <a href="/repositories" class="inline-flex items-center gap-2 text-sm font-bold font-sans px-5 py-2.5 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white transition-all">
        Browse Repositories
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</Layout>
