---
import Navbar from "@/components/Navbar.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Project Ideas — GitNews" description="Developer project recommendations.">
  <Navbar />
  
  <div class="w-full min-h-[calc(100vh-64px)] bg-stone-50 text-slate-900 dark:bg-[#0a0a0a] dark:text-slate-200 flex flex-col items-center justify-center p-8">
    <div class="text-center max-w-lg">
      <div class="w-16 h-16 bg-emerald-500/10 text-emerald-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
      </div>
      <h1 class="text-4xl font-serif font-black tracking-tighter mb-4 text-slate-900 dark:text-white">Project Ideas</h1>
      <p class="text-stone-500 dark:text-stone-400 text-lg mb-8">Get personalized developer project recommendations based on trending tech.</p>
      
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-stone-100 dark:bg-stone-900 text-stone-600 dark:text-stone-300 rounded-full text-sm font-mono font-bold uppercase tracking-widest border border-stone-200 dark:border-stone-800">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Coming Soon
      </span>
    </div>
  </div>
</Layout>
