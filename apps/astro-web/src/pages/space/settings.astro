---
import Navbar from "@/components/Navbar.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Settings — GitNews" description="Configure your GitNews experience.">
  <Navbar />
  
  <div class="w-full min-h-[calc(100vh-64px)] bg-stone-50 text-slate-900 dark:bg-[#0a0a0a] dark:text-slate-200 flex flex-col items-center justify-center p-8">
    <div class="text-center max-w-lg">
      <div class="w-16 h-16 bg-emerald-500/10 text-emerald-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <h1 class="text-4xl font-serif font-black tracking-tighter mb-4 text-slate-900 dark:text-white">Settings</h1>
      <p class="text-stone-500 dark:text-stone-400 text-lg mb-8">Configure API integrations, themes, and intelligence preferences.</p>
      
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-stone-100 dark:bg-stone-900 text-stone-600 dark:text-stone-300 rounded-full text-sm font-mono font-bold uppercase tracking-widest border border-stone-200 dark:border-stone-800">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Coming Soon
      </span>
    </div>
  </div>
</Layout>
