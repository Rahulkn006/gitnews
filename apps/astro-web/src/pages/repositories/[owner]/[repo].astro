---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import { fetcher } from "@/lib/api";

if (!(globalThis as any).__fetchInstrumented) {
  (globalThis as any).__fetchInstrumented = true;
  const originalFetch = globalThis.fetch;
  globalThis.fetch = async (...args) => {
    const url = typeof args[0] === 'string' ? args[0] : (args[0] as any)?.url || 'unknown';
    console.log(`[SSR INST] [GLOBAL FETCH START] URL: ${url}`);
    const start = Date.now();
    try {
      const response = await originalFetch(...args);
      console.log(`[SSR INST] [GLOBAL FETCH SUCCESS] (${Date.now() - start}ms) URL: ${url} STATUS: ${response.status}`);
      return response;
    } catch (e: any) {
      console.log(`[SSR INST] [GLOBAL FETCH ERROR] (${Date.now() - start}ms) URL: ${url} ERROR: ${e.message}`);
      throw e;
    }
  };
}

import IntelligenceGrid from "@/components/intelligence/IntelligenceGrid.astro";
import RepoHeader from "@/components/intelligence/RepoHeader.astro";
import RepoResearchSidebar from "@/components/intelligence/RepoResearchSidebar.astro";
import WhyWatching from "@/components/intelligence/WhyWatching.astro";
import YoutubeLearningHub from "@/components/intelligence/YoutubeLearningHub.astro";
import OllagraphDeepResearchClient from "@/components/react/OllagraphDeepResearchClient";
import SimilarReposSidebar from "@/components/react/SimilarReposSidebar";
import { BackNavigation } from "@/components/react/back-navigation";
// Use "repo" from params since file is [repo].astro
const { owner, repo: name } = Astro.params;

console.log("[SSR INST] [START] SSR START for owner:", owner, "repo:", name);

let repo;
let analysis: any = {};
let title = "";
let description = "";
let learningValue = "";
let futurePotential = "";

try {
  if (!owner || !name) {
    return Astro.redirect("/");
  }

  try {
    console.log("[SSR INST] [FETCH] Repository fetch begins for /api/repositories/" + owner + "/" + name);
    repo = await fetcher(`/api/repositories/${owner}/${name}`);
    console.log("[SSR INST] [FETCH] Repository fetch completed");
  } catch (e) {
    console.error("[SSR INST] [ERROR] Repository fetch failed", e);
  }

  if (!repo) {
    return Astro.redirect("/");
  }

  if (repo.analysis) {
    try {
      console.log("[SSR INST] [PARSE] Analysis parsing begins");
      analysis = {
        ...repo.analysis,
        deepResearch: repo.analysis.deepResearch ? JSON.parse(repo.analysis.deepResearch) : null,
        scores: repo.analysis.scores ? JSON.parse(repo.analysis.scores) : null,
        codeIntelligence: repo.analysis.codeIntelligence ? JSON.parse(repo.analysis.codeIntelligence) : null,
        techStack: repo.analysis.techStack ? JSON.parse(repo.analysis.techStack) : null,
      };
      console.log("[SSR INST] [PARSE] Analysis parsing completed");
    } catch (e) {
      console.error("Failed to parse repo.analysis JSON fields", e);
    }
  }
  console.log("[SSR INST] [RENDER] Preparing to render components...");

  title = `${repo.name} by ${repo.owner} - GitNews Analysis`;
  description =
    analysis.summary ||
    repo.description ||
    `In-depth developer analysis for ${owner}/${name}`;

  learningValue =
    analysis.learningDifficulty || repo.verdict?.learningValue || "Intermediate";
  futurePotential =
    analysis.futurePotential || repo.verdict?.futurePotential || "Growing";

} catch (error: any) {
  console.error("[SSR EXCEPTION CAUGHT]");
  console.error("error.name:", error?.name);
  console.error("error.message:", error?.message);
  console.error("error.stack:", error?.stack);
  console.error("error.cause:", error?.cause);
  
  let currentCause = error?.cause;
  let depth = 1;
  while (currentCause) {
    console.error(`nested cause ${depth}:`, currentCause);
    currentCause = currentCause.cause;
    depth++;
  }

  console.error("request URL:", Astro.request.url);
  console.error("repository owner:", owner);
  console.error("repository name:", name);
  
  throw error;
}
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-white text-stone-900 dark:bg-[#0a0a0a] dark:text-stone-200 font-sans selection:bg-emerald-500 selection:text-white pt-10 pb-20">
    <div class="max-w-[1500px] mx-auto px-4 md:px-8">
      
      <BackNavigation label="Back to Feed" className="mb-8" />
      <RepoHeader 
        name={repo.name} 
        owner={repo.owner} 
        description={description} 
        language={repo.language} 
        stars={repo.stars} 
        forks={repo.forks} 
        weeklyGrowth={Math.floor(repo.forks * 0.1)} 
      />

      {/* 2-Column Responsive Layout */}
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] xl:grid-cols-[1fr_340px] gap-8 xl:gap-12 items-start mt-12 mb-16">
        
        {/* Main Content Area (70%) */}
        <div class="flex flex-col gap-8 min-w-0">
          <WhyWatching 
            growthSignal={analysis.whyTrending || "+35k developers started watching this"}
            developerAdoption={analysis.developerAdoption || "Used in production by thousands of projects"}
            whyItMatters={analysis.whatItDoes || "Strong community adoption and recent activity signals make this a critical project to follow."}
          />

          <IntelligenceGrid 
            overview={analysis.summary || repo.description}
            bestUseCases={analysis.useCases || repo.developerAnalysis?.ecosystemFit}
            learningDifficulty={learningValue}
            futurePotential={futurePotential}
          />

          <OllagraphDeepResearchClient client:load owner={owner} repo={name} />
        </div>

        {/* Sticky Sidebar Area (30%) */}
        <div class="sticky top-24 self-start flex flex-col gap-8 w-full max-h-[calc(100vh-7rem)] overflow-y-auto">
          <RepoResearchSidebar 
            repoName={repo.name}
            analysis={analysis}
            score={repo.trendingScore || 99}
          />
          <SimilarReposSidebar client:load owner={owner} repo={name} />
        </div>

      </div>

      {/* Full Width YouTube Learning Hub */}
      {(() => { console.log("[SSR INST] [RENDER] YoutubeLearningHub begins"); return null; })()}
      <YoutubeLearningHub repoName={repo.name} owner={repo.owner} language={repo.language} />
      {(() => { console.log("[SSR INST] [RENDER] YoutubeLearningHub completed"); return null; })()}

    </div>
  </div>
</Layout>
{(() => { console.log("[SSR INST] [END] SSR END for", owner, name); return null; })()}
