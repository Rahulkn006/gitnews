---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
---

<Layout title="Signals — GitNews" description="Detailed developer market signals.">
  <Navbar />
  
  <div class="w-full min-h-[calc(100vh-64px)] bg-stone-50 text-slate-900 dark:bg-[#0a0a0a] dark:text-slate-200 flex flex-col items-center justify-center p-8">
    <div class="text-center max-w-lg">
      <div class="w-16 h-16 bg-emerald-500/10 text-emerald-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
      </div>
      <h1 class="text-4xl font-serif font-black tracking-tighter mb-4 text-slate-900 dark:text-white">Developer Signals</h1>
      <p class="text-stone-500 dark:text-stone-400 text-lg mb-8">Deep dive into emerging market signals and framework momentum.</p>
      
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-stone-100 dark:bg-stone-900 text-stone-600 dark:text-stone-300 rounded-full text-sm font-mono font-bold uppercase tracking-widest border border-stone-200 dark:border-stone-800">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Coming Soon
      </span>
    </div>
  </div>
</Layout>
