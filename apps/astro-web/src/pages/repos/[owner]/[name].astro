---
export const prerender = false;

import Navbar from "../../../components/Navbar.astro";
import { RepoArticlePage } from "../../../components/react/repo-article-page";
import Layout from "../../../layouts/Layout.astro";

const { owner, name } = Astro.params;

if (!owner || !name) {
  return Astro.redirect("/repos");
}
---

<Layout title={`${owner}/${name} — GitNews Intelligence`} description={`Intelligence report for ${owner}/${name}`}>
  <Navbar />
  <RepoArticlePage client:load owner={owner} name={name} />
</Layout>
