---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import { ConvexHttpClient } from "convex/browser";
import { api } from "@v1/backend/convex/_generated/api";

import RepoHeader from "@/components/intelligence/RepoHeader.astro";
import WhyWatching from "@/components/intelligence/WhyWatching.astro";
import IntelligenceGrid from "@/components/intelligence/IntelligenceGrid.astro";
import RepoResearchSidebar from "@/components/intelligence/RepoResearchSidebar.astro";
import OllagraphDeepResearchClient from "@/components/react/OllagraphDeepResearchClient";
import YoutubeLearningHub from "@/components/intelligence/YoutubeLearningHub.astro";
import SimilarReposSidebar from "@/components/react/SimilarReposSidebar";
import { BackNavigation } from "@/components/react/back-navigation";
import { ollagraph } from "@/services/ollagraph";

// Use "repo" from params since file is [repo].astro
const { owner, repo: name } = Astro.params;

if (!owner || !name) {
  return Astro.redirect("/");
}

const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const repo = await convex.query(api.github.getRepoByOwnerAndName, { owner, name });

if (!repo) {
  return Astro.redirect("/");
}

// Fetch deep research from Ollagraph Intelligence
const analysis = await ollagraph.analyzeRepository(owner, name);

const title = `${repo.name} by ${repo.owner} - GitNews Analysis`;
const description = analysis.summary || repo.description || `In-depth developer analysis for ${owner}/${name}`;

const learningValue = analysis.learningDifficulty || repo.verdict?.learningValue || "Intermediate";
const futurePotential = analysis.futurePotential || repo.verdict?.futurePotential || "Growing";
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-white text-stone-900 dark:bg-[#0a0a0a] dark:text-stone-200 font-sans selection:bg-emerald-500 selection:text-white pt-10 pb-20">
    <div class="max-w-[1500px] mx-auto px-4 md:px-8">
      
      <BackNavigation label="Back to Feed" className="mb-8" />
      <RepoHeader 
        name={repo.name} 
        owner={repo.owner} 
        description={description} 
        language={repo.language} 
        stars={repo.stars} 
        forks={repo.forks} 
        weeklyGrowth={Math.floor(repo.forks * 0.1)} 
      />

      {/* 2-Column Responsive Layout */}
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] xl:grid-cols-[1fr_340px] gap-8 xl:gap-12 items-start mt-12 mb-16">
        
        {/* Main Content Area (70%) */}
        <div class="flex flex-col gap-8 min-w-0">
          <WhyWatching 
            growthSignal={analysis.whyTrending || "+35k developers started watching this"}
            developerAdoption={analysis.developerAdoption || "Used in production by thousands of projects"}
            whyItMatters={analysis.whatItDoes || "Strong community adoption and recent activity signals make this a critical project to follow."}
          />

          <IntelligenceGrid 
            overview={analysis.summary || repo.description}
            bestUseCases={analysis.bestUseCases || repo.developerAnalysis?.ecosystemFit}
            learningDifficulty={learningValue}
            futurePotential={futurePotential}
          />

          <OllagraphDeepResearchClient client:load owner={owner} repo={name} />
        </div>

        {/* Sticky Sidebar Area (30%) */}
        <div class="sticky top-24 self-start flex flex-col gap-8 w-full max-h-[calc(100vh-7rem)] overflow-y-auto">
          <RepoResearchSidebar 
            repoName={repo.name}
            analysis={analysis}
            score={repo.trendingScore || 99}
          />
          <SimilarReposSidebar client:load owner={owner} repo={name} />
        </div>

      </div>

      {/* Full Width YouTube Learning Hub */}
      <YoutubeLearningHub repoName={repo.name} owner={repo.owner} language={repo.language} />

    </div>
  </div>
</Layout>
