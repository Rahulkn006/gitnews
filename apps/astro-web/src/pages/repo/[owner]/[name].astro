---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import { RepoAnalysis } from "@/components/react/repo-analysis";
import { ConvexHttpClient } from "convex/browser";
import { api } from "@v1/backend/convex/_generated/api";

const { owner, name } = Astro.params;

if (!owner || !name) {
  return Astro.redirect("/");
}

// Optionally fetch the SEO metadata for the page title
const convex = new ConvexHttpClient(import.meta.env.PUBLIC_CONVEX_URL);
const repo = await convex.query(api.github.getRepoByOwnerAndName, { owner, name });

const title = repo ? `${repo.name} by ${repo.owner} - GitNews Analysis` : "Repository Analysis - GitNews";
const description = repo?.description || `In-depth developer analysis for ${owner}/${name}`;
---

<Layout title={title} description={description}>
  <RepoAnalysis owner={owner} name={name} client:load />
</Layout>
