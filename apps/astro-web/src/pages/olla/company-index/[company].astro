---
export const prerender = false;

import Navbar from "@/components/Navbar.astro";
import { CompanyDetail } from "@/components/react/CompanyDetail";
import Layout from "@/layouts/Layout.astro";

const { company } = Astro.params;
---

<Layout title={`${company?.toUpperCase() || 'Company'} Engineering Report — GitNews`} description={`Engineering intelligence report for ${company}`}>
  <Navbar />
  
  <div class="w-full min-h-[calc(100vh-64px)] bg-stone-50 text-slate-900 dark:bg-[#0a0a0a] dark:text-slate-200">
    <CompanyDetail companyName={company || ''} client:load />
  </div>
</Layout>
