---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
---

<Layout title="Compare Repositories — GitNews" description="Compare GitHub repositories.">
  <Navbar />
  
  <div class="w-full min-h-[calc(100vh-64px)] bg-stone-50 text-slate-900 dark:bg-[#0a0a0a] dark:text-slate-200 flex flex-col items-center justify-center p-8">
    <div class="text-center max-w-lg">
      <div class="w-16 h-16 bg-emerald-500/10 text-emerald-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
        </svg>
      </div>
      <h1 class="text-4xl font-serif font-black tracking-tighter mb-4 text-slate-900 dark:text-white">Compare Repositories</h1>
      <p class="text-stone-500 dark:text-stone-400 text-lg mb-8">Compare GitHub repositories side-by-side with Olla AI.</p>
      
      <span class="inline-flex items-center gap-2 px-4 py-2 bg-stone-100 dark:bg-stone-900 text-stone-600 dark:text-stone-300 rounded-full text-sm font-mono font-bold uppercase tracking-widest border border-stone-200 dark:border-stone-800">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Coming Soon
      </span>
    </div>
  </div>
</Layout>
