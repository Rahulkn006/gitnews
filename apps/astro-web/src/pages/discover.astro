---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Discover — GitNews" description="Explore new and rising open-source projects, hidden gems, and developer tools across AI, DevOps, and web development.">
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 md:py-16">
    <!-- Masthead -->
    <div class="border-b border-stone-200 dark:border-stone-800 pb-8 mb-10">
      <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-emerald-600 dark:text-emerald-500 mb-3 block">Explore</span>
      <h1 class="font-serif font-black text-4xl md:text-5xl text-slate-900 dark:text-white tracking-tighter mb-4">
        Discover.
      </h1>
      <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl font-serif leading-relaxed">
        Find new and rising open-source projects, hidden gems, and developer tools across AI, DevOps, mobile, and web development.
      </p>
    </div>

    <!-- Category discovery grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      <a href="/ai" class="group relative overflow-hidden rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] p-6 hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
          <svg class="w-16 h-16 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h3 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">AI Projects</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">LLM frameworks, agents, local models, and machine learning tools.</p>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-500 uppercase tracking-wider">Explore →</span>
      </a>

      <a href="/trending" class="group relative overflow-hidden rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] p-6 hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
          <svg class="w-16 h-16 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <h3 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Trending</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">The fastest-growing repositories today, this week, and this month.</p>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-500 uppercase tracking-wider">Explore →</span>
      </a>

      <a href="/learning/projects" class="group relative overflow-hidden rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] p-6 hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
          <svg class="w-16 h-16 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <h3 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Project Ideas</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Curated open-source projects to learn from, fork, or extend.</p>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-500 uppercase tracking-wider">Explore →</span>
      </a>

      <a href="/market/open-source" class="group relative overflow-hidden rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] p-6 hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
          <svg class="w-16 h-16 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
        </div>
        <h3 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Open Source Market</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Market cap, velocity, and economic signals in open source.</p>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-500 uppercase tracking-wider">Explore →</span>
      </a>

      <a href="/learning/interview" class="group relative overflow-hidden rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] p-6 hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
          <svg class="w-16 h-16 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <h3 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">Interview Prep</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Repositories and resources to prepare for technical interviews.</p>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-500 uppercase tracking-wider">Explore →</span>
      </a>

      <a href="/news" class="group relative overflow-hidden rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] p-6 hover:border-emerald-200 dark:hover:border-emerald-500/30 transition-all">
        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
          <svg class="w-16 h-16 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 4h-2m2 0h-3m3 0V9m-3 3h3m-3 3h3m-3 3h3M9 17h1m-1-3h1m-1-3h1m-1-3h1" />
          </svg>
        </div>
        <h3 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">AI News</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Daily dispatches from the world of AI, developer tools, and open source.</p>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-500 uppercase tracking-wider">Explore →</span>
      </a>
    </div>

    <!-- CTA -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#0f0f0f] p-6 md:p-8">
      <div>
        <h3 class="font-serif font-bold text-xl text-slate-900 dark:text-white mb-2">Not sure where to start?</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400">Browse the full repository catalog with filters and AI summaries.</p>
      </div>
      <a href="/repos" class="inline-flex items-center gap-2 text-sm font-bold font-sans px-5 py-2.5 rounded-md bg-emerald-600 hover:bg-emerald-700 text-white transition-all">
        Browse All Repositories
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</Layout>
